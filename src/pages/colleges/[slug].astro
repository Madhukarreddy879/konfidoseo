---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { collegesData, type College } from '../../data/colleges';

export async function getStaticPaths() {
  return collegesData.map((college) => ({
    params: { slug: college.slug },
    props: { college },
  }));
}

interface Props {
  college: College;
}

const { college } = Astro.props;

// Meta Tags
const metaTitle = college.metaTitle || `${college.name} Admissions 2025: Fees, Cutoffs, Direct Quota, Placements | Konfido`;
const metaDescription = college.metaDescription || `Verified 2025 fee structures, cutoff ranks, placement packages & direct management quota guidance for ${college.name} (${college.city}, ${college.state}). Free counselling by Konfido senior advisors.`;

// Similar colleges in the same region
const similarColleges = collegesData
  .filter((c) => c.slug !== college.slug && (c.state.includes(college.state) || c.region === college.region))
  .slice(0, 3);

// FAQs for this university (custom prioritized, fallback to default)
const activeFaqs = (college.customFaqs && college.customFaqs.length > 0) ? college.customFaqs : [
  {
    q: `How can I get direct admission in ${college.name} under management quota for 2025?`,
    a: `Direct admission in ${college.name} under Category-B / Management Quota is available for eligible candidates who have completed 10+2 with Physics, Mathematics, and Chemistry (PCM) with a minimum of 60% aggregate. Konfido assists students with quota seat mapping, transparent fee documentation, and confirmed provisional allotment directly from the university admission desk.`
  },
  {
    q: `What is the fee structure for B.Tech CSE in ${college.name} for 2025–2026?`,
    a: `The annual tuition fee for B.Tech programs at ${college.name} ranges approximately from ${college.annualFee}. Convenor quota seats through state counselling have lower subsidized tuition, while management / NRI quota seats have fixed institutional fee schedules. Hostel and mess charges are additional, ranging between ₹90,000 to ₹1,80,000 depending on AC/Non-AC accommodation.`
  },
  {
    q: `What is the average and highest placement package at ${college.name}?`,
    a: `${college.name} reports an average placement package of ${college.avgPackage} and a record highest CTC of ${college.highestPackage}. Premier tech corporations such as Amazon, Microsoft, TCS, Infosys, Cognizant, and Wipro actively hire graduates during campus recruitment cycles.`
  },
  {
    q: `Which entrance exams are accepted for admission into ${college.name}?`,
    a: `${college.name} accepts scores from: ${college.exams.join(', ')}. Students who did not achieve high rank in entrance tests can still explore institutional Category-B quota seats based on their 12th board PCM merit.`
  },
  {
    q: `Does Konfido charge any fees from students for admission guidance?`,
    a: `No. Konfido offers 100% free admission counselling and college shortlisting services for students and parents. All tuition payments are made directly to the university through official bank transfers or demand drafts.`
  }
];

// JSON-LD Schemas
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": activeFaqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
};

const collegeSchema = {
  "@context": "https://schema.org",
  "@type": "CollegeOrUniversity",
  "name": college.name,
  "url": college.website,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": college.city,
    "addressRegion": college.state,
    "addressCountry": "IN"
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://konfido.in"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Colleges",
      "item": "https://konfido.in/colleges"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": college.name,
      "item": `https://konfido.in/colleges/${college.slug}`
    }
  ]
};
---

<BaseLayout title={metaTitle} description={metaDescription}>
  <!-- Inject Schemas into head via script tags -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(collegeSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- Breadcrumbs -->
  <div class="bg-slate-100 border-b border-slate-200 py-3 text-xs font-medium text-slate-500">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-2 flex-wrap">
      <a href="/" class="hover:text-blue-700 transition-colors">Home</a>
      <span>/</span>
      <a href="/colleges" class="hover:text-blue-700 transition-colors">Colleges</a>
      <span>/</span>
      <span class="text-slate-900 font-bold">{college.name}</span>
    </div>
  </div>

  <!-- Hero & University Header Banner -->
  <section class="bg-gradient-to-b from-blue-50/80 via-white to-slate-50 py-10 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
        <div class="space-y-3">
          
          <!-- Badges -->
          <div class="flex items-center gap-2 flex-wrap">
            {college.nirfRank && (
              <span class="badge-nirf">
                <svg class="w-3 h-3 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
                NIRF Engineering Rank #{college.nirfRank}
              </span>
            )}
            {college.naacGrade && (
              <span class="badge-naac">
                NAAC Grade {college.naacGrade}
              </span>
            )}
            <span class="badge-quota">
              Direct & Management Quota 2025 Open
            </span>
            <span class="text-xs font-semibold text-slate-500 bg-slate-100 px-2 py-0.5 rounded">
              Est. {college.established || '2000'}
            </span>
          </div>

          <!-- University Name -->
          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
            {college.name}
          </h1>

          <!-- Location & Type Info -->
          <div class="flex items-center gap-2 text-xs sm:text-sm text-slate-600 font-medium flex-wrap">
            <span class="flex items-center gap-1">
              <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              {college.city}, {college.state}
            </span>
            <span class="text-slate-300">•</span>
            <span class="text-blue-700 font-bold">{college.type}</span>
            <span class="text-slate-300">•</span>
            <a 
              href={college.website} 
              target="_blank" 
              rel="noopener nofollow"
              class="text-slate-500 hover:text-blue-700 transition-colors flex items-center gap-1"
            >
              Official Website
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
            </a>
          </div>

        </div>

        <!-- Direct Action CTAs -->
        <div class="flex flex-col sm:flex-row lg:flex-col gap-2.5 flex-shrink-0">
          <a 
            href={`https://wa.me/919000000000?text=Hi%20Konfido%2C%20I%20want%20direct%20admission%20details%20for%20${encodeURIComponent(college.name)}`}
            target="_blank" 
            rel="noopener"
            class="btn-whatsapp text-xs sm:text-sm py-3 px-5 text-center justify-center font-bold"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
            </svg>
            Enquire Fees on WhatsApp
          </a>

          <a 
            href="#lead-form" 
            class="btn-gold text-xs sm:text-sm py-3 px-5 text-center justify-center font-bold"
          >
            Apply for Management Seat
          </a>
        </div>
      </div>

      <!-- Quick Metrics Strip -->
      <div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4 bg-white p-4 rounded-2xl border border-slate-200 shadow-xs">
        <div class="p-2">
          <span class="block text-xs uppercase font-bold text-slate-400">Average Package</span>
          <span class="text-xl font-black text-slate-900">{college.avgPackage}</span>
          <span class="block text-[11px] text-slate-500">Campus Drives</span>
        </div>
        <div class="p-2 sm:border-l border-slate-200">
          <span class="block text-xs uppercase font-bold text-slate-400">Highest Package</span>
          <span class="text-xl font-black text-emerald-700">{college.highestPackage}</span>
          <span class="block text-[11px] text-slate-500">Record Offer</span>
        </div>
        <div class="p-2 border-t sm:border-t-0 sm:border-l border-slate-200">
          <span class="block text-xs uppercase font-bold text-slate-400">Annual Tuition Fee</span>
          <span class="text-xl font-black text-blue-900">{college.annualFee.split(' - ')[0]}</span>
          <span class="block text-[11px] text-slate-500">Convenor / Merit</span>
        </div>
        <div class="p-2 border-t sm:border-t-0 sm:border-l border-slate-200">
          <span class="block text-xs uppercase font-bold text-slate-400">Accepted Entrance</span>
          <span class="text-sm font-black text-slate-900 truncate block">{college.exams.slice(0, 2).join(', ')}</span>
          <span class="block text-[11px] text-slate-500">& Direct Quota</span>
        </div>
      </div>

    </div>
  </section>

  <!-- Main Body: 2 Columns -->
  <section class="py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
        
        <!-- Left Main Content Column (8 cols) -->
        <div class="lg:col-span-8 space-y-12">
          
          <!-- 1. Overview & Campus -->
          <div class="space-y-4">
            <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight">
              About {college.name}
            </h2>
            {college.detailedOverview && college.detailedOverview.length > 0 ? (
              <div class="space-y-3.5">
                {college.detailedOverview.map((paragraph) => (
                  <p class="text-slate-700 leading-relaxed text-sm sm:text-base">
                    {paragraph}
                  </p>
                ))}
              </div>
            ) : (
              <p class="text-slate-700 leading-relaxed text-sm sm:text-base">
                {college.overview}
              </p>
            )}
            <div class="bg-blue-50/70 border border-blue-200 rounded-xl p-4 text-xs text-blue-950 space-y-1.5">
              <div class="font-bold flex items-center gap-1.5 text-blue-900 text-sm">
                <svg class="w-4 h-4 text-blue-700" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                Key Academic Highlights & Standing:
              </div>
              <p>• {college.highlight}</p>
              <p>• Recognized by University Grants Commission (UGC) & Approved by AICTE, New Delhi.</p>
              <p>• Direct admission assistance for 2025–26 academic year with authorized counselling support.</p>
            </div>
          </div>

          <!-- 2. B.Tech Seat Matrix & Programs -->
          {college.seatMatrix && college.seatMatrix.length > 0 ? (
            <div class="space-y-4">
              <div class="flex items-center justify-between flex-wrap gap-2">
                <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight">
                  B.Tech Seat Matrix & Quota Allocation (2025–26)
                </h2>
                <span class="text-xs font-bold px-2.5 py-1 rounded bg-blue-100 text-blue-800">
                  70% Convenor • 30% Management Quota
                </span>
              </div>
              <p class="text-slate-600 text-sm">
                Sanctioned annual student intake per branch, divided between state entrance counselling (Category-A) and direct institutional quota (Category-B):
              </p>
              <div class="overflow-x-auto rounded-xl border border-slate-200 shadow-xs">
                <table class="w-full text-left text-xs sm:text-sm">
                  <thead class="bg-slate-100 text-slate-800 font-bold border-b border-slate-200">
                    <tr>
                      <th class="p-3.5">Engineering Branch / Discipline</th>
                      <th class="p-3.5 text-center">Total Intake</th>
                      <th class="p-3.5 text-center">Category-A (Convenor)</th>
                      <th class="p-3.5 text-center">Category-B (Management)</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-200 text-slate-700">
                    {college.seatMatrix.map((item) => (
                      <tr class="hover:bg-slate-50/80 transition-colors">
                        <td class="p-3.5 font-semibold text-slate-900">{item.branch}</td>
                        <td class="p-3.5 text-center font-bold">{item.totalSeats}</td>
                        <td class="p-3.5 text-center text-blue-700 font-semibold">{item.catASeats}</td>
                        <td class="p-3.5 text-center text-amber-700 font-bold">{item.catBSeats}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          ) : (
            <div class="space-y-4">
              <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight">
                Popular B.Tech Programs & Specializations
              </h2>
              <p class="text-slate-600 text-sm">
                Below are the primary 4-year undergraduate engineering specializations offered at {college.name} with active seat allocations:
              </p>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                {college.popularCourses.map((course) => (
                  <div class="p-3.5 rounded-xl border border-slate-200 bg-slate-50 flex items-center justify-between">
                    <div class="font-bold text-slate-900 text-sm">{course}</div>
                    <span class="text-[11px] font-bold text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded">
                      Seats Open
                    </span>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- 3. Fee Structure Matrix -->
          {college.detailedFees ? (
            <div class="space-y-4">
              <div class="flex items-center justify-between flex-wrap gap-2">
                <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight">
                  Verified Fee Structure for B.Tech (2025–26)
                </h2>
                <span class="text-xs font-bold px-2.5 py-1 rounded bg-emerald-100 text-emerald-800">
                  TAFRC / Regulatory Audited
                </span>
              </div>
              <p class="text-slate-600 text-sm">
                Verified annual fee matrix for Convenor (Category-A), Management (Category-B), and accommodation expenses:
              </p>

              <div class="overflow-x-auto rounded-xl border border-slate-200 shadow-xs">
                <table class="w-full text-left text-xs sm:text-sm">
                  <thead class="bg-slate-100 text-slate-800 font-bold border-b border-slate-200">
                    <tr>
                      <th class="p-3.5">Fee Component</th>
                      <th class="p-3.5">Category-A (Convenor / Merit)</th>
                      <th class="p-3.5">Category-B (Management / Direct Quota)</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-200 text-slate-700">
                    <tr>
                      <td class="p-3.5 font-semibold">Annual Tuition Fee</td>
                      <td class="p-3.5 font-bold text-slate-900">{college.detailedFees.tuitionConvenor}</td>
                      <td class="p-3.5 font-bold text-blue-950">{college.detailedFees.tuitionManagement}</td>
                    </tr>
                    {college.detailedFees.tuitionNRI && (
                      <tr>
                        <td class="p-3.5 font-semibold">NRI / NRI Sponsored Quota</td>
                        <td class="p-3.5 text-slate-400">—</td>
                        <td class="p-3.5 font-semibold text-slate-800">{college.detailedFees.tuitionNRI}</td>
                      </tr>
                    )}
                    <tr>
                      <td class="p-3.5 font-semibold">One-Time Registration / Univ. Fee</td>
                      <td class="p-3.5">{college.detailedFees.admissionFee}</td>
                      <td class="p-3.5">{college.detailedFees.admissionFee}</td>
                    </tr>
                    <tr>
                      <td class="p-3.5 font-semibold">Caution Deposit (Refundable)</td>
                      <td class="p-3.5">{college.detailedFees.cautionDeposit}</td>
                      <td class="p-3.5">{college.detailedFees.cautionDeposit}</td>
                    </tr>
                    <tr>
                      <td class="p-3.5 font-semibold">Hostel & Mess (Annual AC)</td>
                      <td class="p-3.5">{college.detailedFees.hostelAC}</td>
                      <td class="p-3.5">{college.detailedFees.hostelAC}</td>
                    </tr>
                    <tr>
                      <td class="p-3.5 font-semibold">Hostel & Mess (Annual Non-AC)</td>
                      <td class="p-3.5">{college.detailedFees.hostelNonAC}</td>
                      <td class="p-3.5">{college.detailedFees.hostelNonAC}</td>
                    </tr>
                    {college.detailedFees.transportFee && (
                      <tr>
                        <td class="p-3.5 font-semibold">Campus Bus Transport (Optional)</td>
                        <td class="p-3.5" colspan="2">{college.detailedFees.transportFee}</td>
                      </tr>
                    )}
                  </tbody>
                </table>
              </div>
              {college.detailedFees.tafrcNote && (
                <div class="bg-amber-50/70 border border-amber-200 rounded-xl p-4 text-xs text-amber-950 space-y-1">
                  <div class="font-bold flex items-center gap-1.5 text-amber-900 text-sm">
                    <svg class="w-4 h-4 text-amber-600" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                    </svg>
                    Important Regulatory & Fee Reimbursement Note:
                  </div>
                  <p class="leading-relaxed">{college.detailedFees.tafrcNote}</p>
                </div>
              )}
            </div>
          ) : (
            <div class="space-y-4">
              <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight">
                Estimated Fee Structure for B.Tech (2025–26)
              </h2>
              <p class="text-slate-600 text-sm">
                Verified fee matrix for Convenor (Category-A), Management (Category-B), and Hostel expenses:
              </p>

              <div class="overflow-x-auto rounded-xl border border-slate-200">
                <table class="w-full text-left text-xs sm:text-sm">
                  <thead class="bg-slate-100 text-slate-800 font-bold border-b border-slate-200">
                    <tr>
                      <th class="p-3.5">Fee Component</th>
                      <th class="p-3.5">Convenor Quota (Merit)</th>
                      <th class="p-3.5">Management / Direct Quota</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-200 text-slate-700">
                    <tr>
                      <td class="p-3.5 font-semibold">Annual Tuition Fee</td>
                      <td class="p-3.5 font-bold text-slate-900">{college.annualFee.split(' - ')[0]}</td>
                      <td class="p-3.5 font-bold text-blue-950">{college.annualFee.split(' - ')[1] || college.annualFee}</td>
                    </tr>
                    <tr>
                      <td class="p-3.5 font-semibold">Admission / Caution Deposit</td>
                      <td class="p-3.5">₹10,000 – ₹25,000 (One-time)</td>
                      <td class="p-3.5">₹10,000 – ₹25,000 (Refundable)</td>
                    </tr>
                    <tr>
                      <td class="p-3.5 font-semibold">Hostel & Mess (Annual)</td>
                      <td class="p-3.5">₹95,000 – ₹1,50,000</td>
                      <td class="p-3.5">₹95,000 – ₹1,80,000 (AC/Non-AC)</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          )}

          <!-- 4. Cutoff Trends & Closing Ranks -->
          {college.cutoffHistory && college.cutoffHistory.length > 0 ? (
            <div class="space-y-4">
              <div class="flex items-center justify-between flex-wrap gap-2">
                <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight">
                  TS EAMCET / Entrance Cutoff Trends (2024 vs 2023)
                </h2>
                <span class="text-xs font-bold px-2.5 py-1 rounded bg-purple-100 text-purple-800">
                  Official Final Phase Closing Ranks
                </span>
              </div>
              <p class="text-slate-600 text-sm">
                Compare last two years' final counselling round closing ranks for general category. Candidates with ranks above these cutoffs can explore institutional Category-B seats:
              </p>
              <div class="overflow-x-auto rounded-xl border border-slate-200 shadow-xs">
                <table class="w-full text-left text-xs sm:text-sm">
                  <thead class="bg-slate-100 text-slate-800 font-bold border-b border-slate-200">
                    <tr>
                      <th class="p-3.5">Branch / Specialization</th>
                      <th class="p-3.5">Category</th>
                      <th class="p-3.5 text-center">2024 Closing Rank</th>
                      <th class="p-3.5 text-center">2023 Closing Rank</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-200 text-slate-700">
                    {college.cutoffHistory.map((item) => (
                      <tr class="hover:bg-slate-50/80 transition-colors">
                        <td class="p-3.5 font-semibold text-slate-900">{item.branch}</td>
                        <td class="p-3.5 text-xs text-slate-500">{item.category}</td>
                        <td class="p-3.5 text-center font-bold text-blue-700">{item.rank2024}</td>
                        <td class="p-3.5 text-center font-medium text-slate-600">{item.rank2023}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          ) : (
            <div class="space-y-4">
              <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight">
                Eligibility & Cutoff Guidance
              </h2>
              <div class="space-y-3 text-sm text-slate-700">
                <div class="p-4 rounded-xl border border-slate-200 bg-slate-50">
                  <h4 class="font-bold text-slate-900 mb-1">General Eligibility for B.Tech:</h4>
                  <ul class="list-disc list-inside space-y-1 text-slate-600 text-xs sm:text-sm">
                    <li>Minimum 50% to 60% aggregate in Class 12th Board examinations with Physics, Mathematics, and Chemistry (PCM).</li>
                    <li>Valid rank in accepted entrance examinations ({college.exams.join(', ')}) or direct application through institutional Category-B criteria.</li>
                    <li>Lateral entry available for 3-year Diploma holders into 2nd year B.Tech.</li>
                  </ul>
                </div>
              </div>
            </div>
          )}

          <!-- 5. Direct Admission & Category-B Process -->
          {college.directAdmissionSteps && college.directAdmissionSteps.length > 0 && (
            <div class="space-y-4">
              <div class="flex items-center justify-between flex-wrap gap-2">
                <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight">
                  Direct Admission & Category-B Process (2025–26)
                </h2>
                <span class="text-xs font-bold px-2.5 py-1 rounded bg-amber-100 text-amber-900">
                  Institutional Quota Protocol
                </span>
              </div>
              <p class="text-slate-600 text-sm">
                Step-by-step guidance for students securing seats under institutional management quota without state counselling web options:
              </p>
              <div class="space-y-3">
                {college.directAdmissionSteps.map((s) => (
                  <div class="p-4 rounded-xl border border-slate-200 bg-slate-50 flex gap-4 items-start hover:border-blue-300 transition-colors">
                    <div class="w-8 h-8 rounded-lg bg-blue-700 text-white font-bold text-xs flex items-center justify-center flex-shrink-0 mt-0.5">
                      {s.step}
                    </div>
                    <div>
                      <h4 class="font-bold text-slate-900 text-sm">{s.title}</h4>
                      <p class="text-xs sm:text-sm text-slate-600 mt-1 leading-relaxed">{s.desc}</p>
                    </div>
                  </div>
                ))}
              </div>

              <!-- Document Checklist Box -->
              <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 text-xs space-y-2">
                <div class="font-bold text-slate-800 text-sm">Mandatory Documents Checklist for Category-B Admission:</div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-slate-600">
                  <div>✓ Class 10th / SSC Marks Memo (Original + Copies)</div>
                  <div>✓ Class 12th / Intermediate PCM Marks Memo</div>
                  <div>✓ Transfer Certificate (TC) & Conduct Certificate</div>
                  <div>✓ TS EAPCET / JEE Main Hall Ticket & Rank Card</div>
                  <div>✓ Aadhar Card / Government Photo ID of Student & Parent</div>
                  <div>✓ 6 Passport size photographs of student</div>
                </div>
              </div>
            </div>
          )}

          <!-- 6. Placement Highlights -->
          <div class="space-y-4">
            <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight">
              Placements & Corporate Recruiters
            </h2>
            <p class="text-slate-600 text-sm">
              {college.name} maintains a dedicated training and placement cell (T&P) with partnerships across tier-1 software, consulting, and engineering conglomerates:
            </p>
            
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-center">
              <div class="p-3 rounded-xl border border-slate-200 bg-slate-50">
                <div class="text-xs text-slate-500 font-semibold uppercase">Average CTC</div>
                <div class="text-lg font-black text-slate-900 mt-1">{college.avgPackage}</div>
              </div>
              <div class="p-3 rounded-xl border border-slate-200 bg-slate-50">
                <div class="text-xs text-slate-500 font-semibold uppercase">Highest CTC</div>
                <div class="text-lg font-black text-emerald-700 mt-1">{college.highestPackage}</div>
              </div>
              <div class="p-3 rounded-xl border border-slate-200 bg-slate-50">
                <div class="text-xs text-slate-500 font-semibold uppercase">
                  {college.detailedPlacements ? "Median CTC" : "Recruiting Partners"}
                </div>
                <div class="text-lg font-black text-blue-900 mt-1">
                  {college.detailedPlacements ? college.detailedPlacements.medianCTC : "300+ Companies"}
                </div>
              </div>
              <div class="p-3 rounded-xl border border-slate-200 bg-slate-50">
                <div class="text-xs text-slate-500 font-semibold uppercase">
                  {college.detailedPlacements ? "Total Offers" : "Placement Cell"}
                </div>
                <div class="text-lg font-black text-purple-900 mt-1">
                  {college.detailedPlacements ? college.detailedPlacements.totalOffers : "Active 100%"}
                </div>
              </div>
            </div>

            {college.detailedPlacements && college.detailedPlacements.topRecruiters && (
              <div class="mt-4 pt-4 border-t border-slate-200 space-y-2.5">
                <div class="text-xs font-bold text-slate-700 uppercase tracking-wider">
                  Top Corporate Recruiters:
                </div>
                <div class="flex items-center gap-2 flex-wrap">
                  {college.detailedPlacements.topRecruiters.map((r) => (
                    <span class="px-2.5 py-1 rounded-lg bg-slate-100 text-slate-800 text-xs font-semibold border border-slate-200">
                      {r}
                    </span>
                  ))}
                </div>
              </div>
            )}
          </div>

          <!-- 7. Head-to-Head Comparison -->
          {college.comparisonPeer && (
            <div class="space-y-4">
              <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight">
                Head-to-Head Comparison: {college.name} vs {college.comparisonPeer.name}
              </h2>
              <div class="bg-gradient-to-br from-blue-50/60 to-slate-50 border border-blue-200 rounded-2xl p-5 space-y-4">
                <div class="flex items-center justify-between flex-wrap gap-2">
                  <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-blue-700 text-white uppercase tracking-wider">
                    Counselling Decision Matrix
                  </span>
                  <span class="text-xs text-slate-500 font-semibold">{college.comparisonPeer.tagline}</span>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-sm">
                  <div class="bg-white p-3.5 rounded-xl border border-slate-200 shadow-xs">
                    <div class="font-bold text-slate-800 mb-1">💰 Fee Comparison:</div>
                    <p class="text-slate-600">{college.comparisonPeer.feeComparison}</p>
                  </div>
                  <div class="bg-white p-3.5 rounded-xl border border-slate-200 shadow-xs">
                    <div class="font-bold text-slate-800 mb-1">📊 Cutoff Comparison:</div>
                    <p class="text-slate-600">{college.comparisonPeer.cutoffComparison}</p>
                  </div>
                </div>
                <div class="bg-white p-4 rounded-xl border border-slate-200 text-xs sm:text-sm shadow-xs">
                  <div class="font-bold text-blue-900 mb-1">🎯 Senior Counsellor Verdict:</div>
                  <p class="text-slate-700 leading-relaxed">{college.comparisonPeer.verdict}</p>
                  <div class="mt-3 pt-2 border-t border-slate-100 flex items-center justify-between">
                    <span class="text-xs text-slate-500">Want to explore {college.comparisonPeer.name}?</span>
                    <a href={`/colleges/${college.comparisonPeer.slug}`} class="text-xs font-bold text-blue-700 hover:underline">
                      View {college.comparisonPeer.name} Profile →
                    </a>
                  </div>
                </div>
              </div>
            </div>
          )}

          <!-- 8. Frequently Asked Questions (FAQ Section) -->
          <div class="space-y-6 pt-4 border-t border-slate-200">
            <div>
              <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight">
                Frequently Asked Questions ({college.name})
              </h2>
              <p class="text-slate-600 text-sm mt-1">
                Common questions from parents and students regarding admissions, fees, and quota seats.
              </p>
            </div>

            <div class="space-y-3">
              {activeFaqs.map((faq, i) => (
                <details class="group bg-slate-50 border border-slate-200 rounded-xl p-4 [&_summary::-webkit-details-marker]:hidden">
                  <summary class="flex items-center justify-between cursor-pointer font-bold text-slate-900 text-sm sm:text-base">
                    <span>{faq.q}</span>
                    <span class="ml-4 transition-transform group-open:rotate-180">
                      <svg class="w-5 h-5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                      </svg>
                    </span>
                  </summary>
                  <p class="mt-3 text-slate-600 text-xs sm:text-sm leading-relaxed border-t border-slate-200 pt-3">
                    {faq.a}
                  </p>
                </details>
              ))}
            </div>
          </div>

        </div>

        <!-- Right Sticky Sidebar Column (4 cols) -->
        <div class="lg:col-span-4 space-y-6">
          
          <!-- Sticky Lead Capture Form -->
          <div class="bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden sticky top-24" id="lead-form">
            <div class="bg-gradient-to-r from-slate-900 via-blue-950 to-slate-900 p-5 text-white">
              <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded bg-amber-500 text-slate-950">
                ADMISSION DESK 2025
              </span>
              <h3 class="text-base font-bold mt-2">
                Apply for {college.name}
              </h3>
              <p class="text-xs text-slate-300 mt-0.5">
                Check direct quota seat availability & fee structure.
              </p>
            </div>

            <form class="p-5 space-y-3.5" onsubmit="event.preventDefault(); alert('Your admission enquiry for ' + college.name + ' has been registered! A senior counsellor will contact you on WhatsApp shortly.');">
              <div>
                <label for="lead-name" class="block text-xs font-bold text-slate-700 mb-1">Student Full Name *</label>
                <input 
                  id="lead-name"
                  type="text" 
                  required 
                  placeholder="e.g. Rahul Sharma"
                  class="w-full px-3 py-2 rounded-lg border border-slate-300 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-600"
                />
              </div>

              <div>
                <label for="lead-phone" class="block text-xs font-bold text-slate-700 mb-1">WhatsApp Mobile Number *</label>
                <div class="flex">
                  <span class="inline-flex items-center px-2.5 rounded-l-lg border border-r-0 border-slate-300 bg-slate-100 text-slate-600 text-xs font-semibold">
                    +91
                  </span>
                  <input 
                    id="lead-phone"
                    type="tel" 
                    pattern="[0-9]{10}" 
                    required 
                    placeholder="98765 43210"
                    class="w-full px-3 py-2 rounded-r-lg border border-slate-300 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-600"
                  />
                </div>
              </div>

              <div>
                <label for="lead-course" class="block text-xs font-bold text-slate-700 mb-1">Preferred Branch</label>
                <select id="lead-course" class="w-full px-3 py-2 rounded-lg border border-slate-300 text-xs text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-600">
                  {college.popularCourses.map((c) => (
                    <option>{c}</option>
                  ))}
                  <option>Other / Management Seat</option>
                </select>
              </div>

              <button 
                type="submit" 
                class="w-full btn-gold py-2.5 text-xs font-bold shadow-md hover:shadow-lg transition-all"
              >
                Get Cutoffs & Fee Sheet on WhatsApp →
              </button>

              <p class="text-[10px] text-center text-slate-500">
                🔒 100% Free guidance. No spam guarantee.
              </p>
            </form>

            <!-- Quick WhatsApp Assistance Button -->
            <div class="p-4 border-t border-slate-100 bg-slate-50">
              <a 
                href={`https://wa.me/919000000000?text=Hi%20Konfido%2C%20I%20have%20an%20urgent%20query%20about%20admissions%20in%20${encodeURIComponent(college.name)}`}
                target="_blank"
                rel="noopener"
                class="btn-whatsapp text-xs py-2 px-3 w-full justify-center"
              >
                Instant WhatsApp Chat with Counsellor
              </a>
            </div>

            <!-- Similar Universities in this Region -->
            {similarColleges.length > 0 && (
              <div class="p-5 border-t border-slate-200">
                <div class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-3">
                  Similar Institutions:
                </div>
                <div class="space-y-2.5">
                  {similarColleges.map((sim) => (
                    <a 
                      href={`/colleges/${sim.slug}`}
                      class="block p-2.5 rounded-lg border border-slate-200 hover:border-blue-400 hover:bg-slate-50 transition-all text-xs"
                    >
                      <div class="font-bold text-slate-900">{sim.name}</div>
                      <div class="text-[11px] text-slate-500">{sim.city}, {sim.state} • Avg {sim.avgPackage}</div>
                    </a>
                  ))}
                </div>
              </div>
            )}

          </div>

        </div>

      </div>
    </div>
  </section>

</BaseLayout>
