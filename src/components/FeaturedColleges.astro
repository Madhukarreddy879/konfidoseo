---
import { collegesData } from '../data/colleges';

// Sort featured first, then by NIRF rank
const initialColleges = [...collegesData];
---

<section class="py-14 bg-slate-50 border-b border-slate-200" id="south-india">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4">
      <div>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-bold border border-blue-200 uppercase tracking-wider mb-2">
          <svg class="w-3.5 h-3.5 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
            <path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a10.99 10.99 0 01-1.25 4.949C4 16 7 19 10 19s6-3 6-5.999a10.99 10.99 0 01-1.25-4.95l2.644-1.131a1 1 0 000-1.84l-7-3z"/>
          </svg>
          Official University Directory 2025–26
        </div>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight">
          Explore Top 51 Partner Universities
        </h2>
        <p class="text-sm sm:text-base text-slate-600 mt-1 max-w-2xl font-normal">
          Direct admission assistance, verified fee sheets, cutoffs, and management quota seat matrix.
        </p>
      </div>

      <!-- Live Search Box Inside Directory -->
      <div class="w-full md:w-80">
        <div class="relative">
          <input 
            type="text" 
            id="main-college-search"
            placeholder="Filter by college, city or branch..."
            class="w-full pl-9 pr-4 py-2.5 bg-white rounded-xl border border-slate-300 text-xs font-medium text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent shadow-xs"
          />
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <svg class="h-4 w-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
          </div>
        </div>
      </div>
    </div>

    <!-- State & Category Filter Tabs -->
    <div class="flex items-center gap-2 overflow-x-auto pb-3 mb-8 scrollbar-none" id="state-tabs">
      <button 
        type="button" 
        class="tab-btn active px-4 py-2 rounded-xl text-xs font-bold transition-all whitespace-nowrap bg-blue-700 text-white shadow-sm"
        data-filter="all"
      >
        All Universities (51)
      </button>
      <button 
        type="button" 
        class="tab-btn px-4 py-2 rounded-xl text-xs font-bold transition-all whitespace-nowrap bg-white text-slate-700 border border-slate-200 hover:bg-slate-100"
        data-filter="Telangana"
      >
        Telangana & Hyderabad (8)
      </button>
      <button 
        type="button" 
        class="tab-btn px-4 py-2 rounded-xl text-xs font-bold transition-all whitespace-nowrap bg-white text-slate-700 border border-slate-200 hover:bg-slate-100"
        data-filter="Andhra Pradesh"
      >
        Andhra Pradesh (8)
      </button>
      <button 
        type="button" 
        class="tab-btn px-4 py-2 rounded-xl text-xs font-bold transition-all whitespace-nowrap bg-white text-slate-700 border border-slate-200 hover:bg-slate-100"
        data-filter="Karnataka"
      >
        Karnataka & Bengaluru (7)
      </button>
      <button 
        type="button" 
        class="tab-btn px-4 py-2 rounded-xl text-xs font-bold transition-all whitespace-nowrap bg-white text-slate-700 border border-slate-200 hover:bg-slate-100"
        data-filter="Tamil Nadu"
      >
        Tamil Nadu & Chennai (8)
      </button>
      <button 
        type="button" 
        class="tab-btn px-4 py-2 rounded-xl text-xs font-bold transition-all whitespace-nowrap bg-white text-slate-700 border border-slate-200 hover:bg-slate-100"
        data-filter="North/West"
      >
        North & West India (20)
      </button>
    </div>

    <!-- Active Count Display -->
    <div class="flex items-center justify-between text-xs text-slate-500 mb-6 font-medium">
      <div>
        Showing <span id="visible-count" class="font-bold text-slate-900">{initialColleges.length}</span> verified institutions
      </div>
      <div class="flex items-center gap-1.5 text-emerald-700 font-semibold">
        <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
        AICTE / UGC Recognized & Verified
      </div>
    </div>

    <!-- College Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="colleges-grid">
      {initialColleges.map((college) => (
        <article 
          class="college-card portal-card p-5 flex flex-col justify-between"
          data-state={college.state}
          data-region={college.region}
          data-name={college.name.toLowerCase()}
          data-city={college.city.toLowerCase()}
          data-courses={college.popularCourses.join(' ').toLowerCase()}
        >
          <!-- Top Badges & Institution Info -->
          <div>
            <div class="flex items-start justify-between gap-2 mb-3">
              <div class="flex flex-wrap gap-1.5">
                {college.nirfRank && (
                  <span class="badge-nirf">
                    <svg class="w-3 h-3 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                    NIRF #{college.nirfRank}
                  </span>
                )}
                {college.naacGrade && (
                  <span class="badge-naac">
                    NAAC {college.naacGrade}
                  </span>
                )}
                <span class="badge-quota">
                  Direct Quota Open
                </span>
              </div>
              <span class="text-[11px] font-semibold text-slate-500 bg-slate-100 px-2 py-0.5 rounded">
                Est. {college.established || '2005'}
              </span>
            </div>

            <!-- College Name & Location -->
            <h3 class="text-lg font-bold text-slate-900 group-hover:text-blue-700 transition-colors leading-snug line-clamp-1" title={college.name}>
              {college.name}
            </h3>

            <div class="flex items-center gap-1.5 text-xs text-slate-500 font-medium mt-1 mb-3">
              <svg class="w-3.5 h-3.5 text-slate-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <span>{college.city}, {college.state}</span>
              <span class="text-slate-300">•</span>
              <span class="text-blue-700 font-semibold">{college.type}</span>
            </div>

            <!-- Metrics Matrix: Fees, Avg CTC, Highest CTC -->
            <div class="grid grid-cols-3 gap-2 bg-slate-50 p-2.5 rounded-xl border border-slate-100 my-3 text-center">
              <div>
                <span class="block text-[10px] uppercase font-bold text-slate-400">Avg. Package</span>
                <span class="text-xs font-black text-slate-900">{college.avgPackage}</span>
              </div>
              <div class="border-x border-slate-200">
                <span class="block text-[10px] uppercase font-bold text-slate-400">Highest CTC</span>
                <span class="text-xs font-black text-emerald-700">{college.highestPackage}</span>
              </div>
              <div>
                <span class="block text-[10px] uppercase font-bold text-slate-400">Annual Fee</span>
                <span class="text-[11px] font-black text-blue-900 truncate block">{college.annualFee.split(' - ')[0]}</span>
              </div>
            </div>

            <!-- Popular Streams -->
            <div class="space-y-1.5 mb-4">
              <div class="text-[11px] font-bold text-slate-600 uppercase tracking-wider">
                Specializations:
              </div>
              <div class="flex flex-wrap gap-1">
                {college.popularCourses.slice(0, 3).map((course) => (
                  <span class="text-[10px] font-medium bg-slate-100 text-slate-700 px-2 py-0.5 rounded border border-slate-200">
                    {course}
                  </span>
                ))}
                {college.popularCourses.length > 3 && (
                  <span class="text-[10px] font-semibold text-slate-500 px-1 py-0.5">
                    +{college.popularCourses.length - 3} more
                  </span>
                )}
              </div>
            </div>
          </div>

          <!-- Bottom Action Buttons -->
          <div class="pt-3 border-t border-slate-100 flex items-center gap-2">
            <a 
              href={`https://wa.me/919000000000?text=Hi%20Konfido%2C%20I%20am%20interested%20in%20admission%20at%20${encodeURIComponent(college.name)}`}
              target="_blank"
              rel="noopener"
              class="flex-1 btn-whatsapp text-xs py-2 px-2 text-center justify-center font-bold"
            >
              Enquire Fees
            </a>
            <a 
              href="#enquiry" 
              class="flex-1 btn-navy text-xs py-2 px-2 text-center justify-center font-bold"
            >
              Apply / Seat
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Load More / See All Button -->
    <div class="mt-10 text-center">
      <a 
        href="/colleges" 
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl border border-slate-300 bg-white text-slate-800 text-sm font-bold shadow-xs hover:bg-slate-50 hover:border-slate-400 transition-all"
      >
        <span>View Full Comparison & Detailed Cutoff Sheets for All 51 Colleges</span>
        <svg class="w-4 h-4 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
    </div>

  </div>
</section>

<script>
  // Dynamic client-side filtering by State Tabs & Search Input
  const searchInput = document.getElementById('main-college-search') as HTMLInputElement | null;
  const tabButtons = document.querySelectorAll('.tab-btn');
  const cards = document.querySelectorAll('.college-card');
  const countDisplay = document.getElementById('visible-count');

  let currentFilter = 'all';
  let searchQuery = '';

  function filterCards() {
    let visibleCount = 0;

    cards.forEach((card) => {
      const state = (card.getAttribute('data-state') || '');
      const region = (card.getAttribute('data-region') || '');
      const name = (card.getAttribute('data-name') || '');
      const city = (card.getAttribute('data-city') || '');
      const courses = (card.getAttribute('data-courses') || '');

      let matchesState = false;
      if (currentFilter === 'all') {
        matchesState = true;
      } else if (currentFilter === 'North/West') {
        matchesState = region === 'North India' || region === 'West India' || region === 'Central India';
      } else {
        matchesState = state.toLowerCase().includes(currentFilter.toLowerCase());
      }

      let matchesSearch = true;
      if (searchQuery) {
        matchesSearch = name.includes(searchQuery) || city.includes(searchQuery) || courses.includes(searchQuery) || state.toLowerCase().includes(searchQuery);
      }

      if (matchesState && matchesSearch) {
        (card as HTMLElement).style.display = 'flex';
        visibleCount++;
      } else {
        (card as HTMLElement).style.display = 'none';
      }
    });

    if (countDisplay) {
      countDisplay.textContent = visibleCount.toString();
    }
  }

  // Handle Tab clicks
  tabButtons.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      tabButtons.forEach(b => {
        b.classList.remove('active', 'bg-blue-700', 'text-white', 'shadow-sm');
        b.classList.add('bg-white', 'text-slate-700', 'border', 'border-slate-200');
      });

      const target = e.currentTarget as HTMLElement;
      target.classList.add('active', 'bg-blue-700', 'text-white', 'shadow-sm');
      target.classList.remove('bg-white', 'text-slate-700', 'border-slate-200');

      currentFilter = target.getAttribute('data-filter') || 'all';
      filterCards();
    });
  });

  // Handle Search input
  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
    filterCards();
  });
</script>
