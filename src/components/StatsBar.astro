---
// Credibility & Metrics Banner
const stats = [
  {
    number: "51+",
    label: "Partner Universities",
    subtext: "NAAC A++ & NIRF Ranked",
    iconPath: "M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
  },
  {
    number: "10,000+",
    label: "Students Counselled",
    subtext: "Across South & Pan-India",
    iconPath: "M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"
  },
  {
    number: "₹0 Fees",
    label: "100% Free Counselling",
    subtext: "Zero Consultancy Charges",
    iconPath: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
  },
  {
    number: "4.9 / 5",
    label: "Parent Trust Score",
    subtext: "Based on 1,800+ Admissions",
    iconPath: "M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"
  }
];
---

<div class="bg-white border-b border-slate-200 py-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
      {stats.map((stat) => (
        <div class="flex items-center gap-4 p-3 rounded-xl hover:bg-slate-50 transition-colors">
          <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-700 flex items-center justify-center flex-shrink-0 border border-blue-100 shadow-xs">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={stat.iconPath} />
            </svg>
          </div>
          <div>
            <div class="text-2xl font-black text-slate-900 tracking-tight leading-tight">
              {stat.number}
            </div>
            <div class="text-xs font-bold text-slate-800 mt-0.5">
              {stat.label}
            </div>
            <div class="text-[11px] text-slate-500 font-medium">
              {stat.subtext}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>
