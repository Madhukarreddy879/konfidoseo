---
import BaseLayout from '../layouts/BaseLayout.astro';
import { stateHubsData, type StateHub } from '../data/stateHubs';
import { collegesData, type College } from '../data/colleges';

interface Props {
  stateKey: string;
}

const { stateKey } = Astro.props;
const hub: StateHub = stateHubsData[stateKey];

if (!hub) {
  throw new Error(`State hub not found for key: ${stateKey}`);
}

// Filter colleges belonging to this state/region
const stateColleges = collegesData.filter((c) => {
  if (hub.collegeFilterKey === "North/West") {
    return c.region === 'North India' || c.region === 'West India' || c.region === 'Central India';
  }
  return c.state.toLowerCase().includes(hub.collegeFilterKey.toLowerCase());
});

// JSON-LD Schemas
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": hub.faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
};
---

<BaseLayout title={hub.title} description={hub.metaDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Breadcrumbs -->
  <div class="bg-slate-100 border-b border-slate-200 py-3 text-xs font-medium text-slate-500">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center gap-2 flex-wrap">
      <a href="/" class="hover:text-blue-700 transition-colors">Home</a>
      <span>/</span>
      <a href="/colleges" class="hover:text-blue-700 transition-colors">Colleges</a>
      <span>/</span>
      <span class="text-slate-900 font-bold">{hub.name} Hub</span>
    </div>
  </div>

  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-blue-50/80 via-white to-slate-50 py-12 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl space-y-4">
        
        <!-- Badges -->
        <div class="flex items-center gap-2 flex-wrap">
          <span class="px-3 py-1 rounded-full bg-blue-100 text-blue-800 text-xs font-bold uppercase tracking-wider">
            📍 Regional Admission Hub 2025–26
          </span>
          <span class="px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold">
            {stateColleges.length} Verified Institutions
          </span>
          <span class="px-3 py-1 rounded-full bg-amber-100 text-amber-800 text-xs font-bold">
            Direct & Management Quota Open
          </span>
        </div>

        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
          Top Engineering Colleges in {hub.name}
        </h1>

        <p class="text-sm sm:text-base text-slate-600 leading-relaxed font-normal">
          {hub.heroTagline}
        </p>

        <!-- Cities Pill Bar -->
        <div class="pt-2 flex items-center gap-2 flex-wrap text-xs text-slate-500">
          <span class="font-bold text-slate-700">Hub Campuses:</span>
          {hub.hubCities.map((city) => (
            <span class="px-2.5 py-1 rounded-lg bg-white border border-slate-200 text-slate-700 font-semibold shadow-xs">
              {city}
            </span>
          ))}
        </div>

      </div>

      <!-- State Quota Policy Summary Card -->
      <div class="mt-8 bg-white p-5 rounded-2xl border border-slate-200 shadow-sm max-w-4xl space-y-3">
        <div class="flex items-center gap-2 text-sm font-bold text-blue-900">
          <svg class="w-5 h-5 text-blue-700 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
          </svg>
          <span>Admission & Quota Seat Framework ({hub.shortName})</span>
        </div>
        <p class="text-xs sm:text-sm text-slate-700 leading-relaxed">
          {hub.quotaRulesOverview}
        </p>
        <div class="pt-2 border-t border-slate-100 flex items-center gap-4 text-xs font-semibold text-slate-600 flex-wrap">
          <div><span class="text-slate-400">Authority:</span> {hub.counsellingBody}</div>
          <div><span class="text-slate-400">Accepted Entrance:</span> {hub.entranceExams.join(', ')}</div>
        </div>
      </div>

    </div>
  </section>

  <!-- Colleges List in this State -->
  <section class="py-12 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900">
            Verified Universities in {hub.name}
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 mt-0.5">
            Showing all {stateColleges.length} partner institutions with active 2025–26 admissions
          </p>
        </div>

        <a 
          href={`https://wa.me/919000000000?text=Hi%20Konfido%2C%20I%20need%20admission%20guidance%20for%20colleges%20in%20${encodeURIComponent(hub.shortName)}`}
          target="_blank" 
          rel="noopener"
          class="btn-whatsapp text-xs py-2 px-3.5 self-start sm:self-auto font-bold"
        >
          Chat with {hub.shortName} Counsellor
        </a>
      </div>

      <!-- College Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {stateColleges.map((college) => (
          <article class="portal-card p-5 flex flex-col justify-between">
            <div>
              <div class="flex items-start justify-between gap-2 mb-3">
                <div class="flex flex-wrap gap-1.5">
                  {college.nirfRank && (
                    <span class="badge-nirf">NIRF #{college.nirfRank}</span>
                  )}
                  {college.naacGrade && (
                    <span class="badge-naac">NAAC {college.naacGrade}</span>
                  )}
                  <span class="badge-quota">Direct Quota</span>
                </div>
                <span class="text-[11px] font-semibold text-slate-500 bg-slate-100 px-2 py-0.5 rounded">
                  Est. {college.established || '2000'}
                </span>
              </div>

              <h3 class="text-base sm:text-lg font-bold text-slate-900 hover:text-blue-700 transition-colors leading-snug">
                <a href={`/colleges/${college.slug}`}>
                  {college.name}
                </a>
              </h3>

              <div class="flex items-center gap-1.5 text-xs text-slate-500 font-medium mt-1 mb-3">
                <svg class="w-3.5 h-3.5 text-slate-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                <span>{college.city}</span>
                <span class="text-slate-300">•</span>
                <span class="text-blue-700 font-semibold">{college.type}</span>
              </div>

              <!-- 3-Metrics -->
              <div class="grid grid-cols-3 gap-2 bg-slate-50 p-2.5 rounded-xl border border-slate-100 my-3 text-center">
                <div>
                  <span class="block text-[10px] uppercase font-bold text-slate-400">Avg CTC</span>
                  <span class="text-xs font-black text-slate-900">{college.avgPackage}</span>
                </div>
                <div class="border-x border-slate-200">
                  <span class="block text-[10px] uppercase font-bold text-slate-400">Highest</span>
                  <span class="text-xs font-black text-emerald-700">{college.highestPackage}</span>
                </div>
                <div>
                  <span class="block text-[10px] uppercase font-bold text-slate-400">Tuition/Yr</span>
                  <span class="text-[11px] font-black text-blue-900 truncate block">{college.annualFee.split(' - ')[0]}</span>
                </div>
              </div>

              <!-- Popular Branches -->
              <div class="space-y-1 mb-4">
                <div class="text-[11px] font-bold text-slate-600 uppercase tracking-wider">Specializations:</div>
                <div class="flex flex-wrap gap-1">
                  {college.popularCourses.slice(0, 3).map((course) => (
                    <span class="text-[10px] font-medium bg-slate-100 text-slate-700 px-2 py-0.5 rounded border border-slate-200">
                      {course}
                    </span>
                  ))}
                  {college.popularCourses.length > 3 && (
                    <span class="text-[10px] font-semibold text-slate-500 px-1 py-0.5">
                      +{college.popularCourses.length - 3} more
                    </span>
                  )}
                </div>
              </div>
            </div>

            <!-- Card Bottom Actions -->
            <div class="pt-3 border-t border-slate-100 flex items-center gap-2">
              <a 
                href={`/colleges/${college.slug}`}
                class="flex-1 btn-navy text-xs py-2 px-2 text-center justify-center font-bold"
              >
                View Fees & Cutoffs →
              </a>
              <a 
                href={`https://wa.me/919000000000?text=Hi%20Konfido%2C%20I%20am%20interested%20in%20admission%20at%20${encodeURIComponent(college.name)}`}
                target="_blank"
                rel="noopener"
                class="btn-whatsapp text-xs py-2 px-3 text-center justify-center font-bold"
              >
                Enquire
              </a>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- Comparison Table Matrix -->
  <section class="py-14 bg-white border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="mb-8">
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900">
          Comparison Matrix: Engineering Universities in {hub.name}
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 mt-0.5">
          Side-by-side comparison of rankings, annual fees, and placement records.
        </p>
      </div>

      <div class="overflow-x-auto rounded-xl border border-slate-200">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead class="bg-slate-100 text-slate-800 font-bold border-b border-slate-200">
            <tr>
              <th class="p-3.5">Institution Name</th>
              <th class="p-3.5">NIRF / NAAC</th>
              <th class="p-3.5">Annual Fee Range</th>
              <th class="p-3.5">Avg Package</th>
              <th class="p-3.5">Highest Package</th>
              <th class="p-3.5">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 text-slate-700">
            {stateColleges.map((c) => (
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="p-3.5 font-bold text-slate-900">
                  <a href={`/colleges/${c.slug}`} class="hover:text-blue-700">
                    {c.name}
                  </a>
                  <span class="block text-[11px] text-slate-400 font-normal">{c.city}</span>
                </td>
                <td class="p-3.5">
                  <span class="font-semibold text-blue-700">{c.nirfRank ? `NIRF #${c.nirfRank}` : 'Unranked'}</span>
                  {c.naacGrade && <span class="block text-[11px] text-emerald-700 font-bold">NAAC {c.naacGrade}</span>}
                </td>
                <td class="p-3.5 font-medium">{c.annualFee}</td>
                <td class="p-3.5 font-bold text-slate-900">{c.avgPackage}</td>
                <td class="p-3.5 font-bold text-emerald-700">{c.highestPackage}</td>
                <td class="p-3.5">
                  <a href={`/colleges/${c.slug}`} class="text-blue-700 font-bold hover:underline text-xs">
                    View Details →
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

    </div>
  </section>

  <!-- Step-by-Step State Admission Roadmap -->
  <section class="py-14 bg-slate-50 border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl mb-10">
        <span class="text-xs font-bold text-blue-700 uppercase tracking-widest bg-blue-100 px-2.5 py-0.5 rounded">
          Admission Procedure
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-2">
          Step-by-Step Engineering Admission in {hub.name}
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          Navigating convenor and management quota seats without confusion.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {hub.admissionSteps.map((step, idx) => (
          <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs hover:border-blue-400 transition-all">
            <div class="w-9 h-9 rounded-xl bg-blue-700 text-white font-black text-xs flex items-center justify-center mb-3">
              0{idx + 1}
            </div>
            <h3 class="text-sm font-bold text-slate-900 mb-1.5">{step.title}</h3>
            <p class="text-xs text-slate-600 leading-relaxed font-normal">{step.desc}</p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- State FAQs Section -->
  <section class="py-14 bg-white border-t border-slate-200">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="mb-8">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900">
          Frequently Asked Questions ({hub.name})
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          Everything parents and students need to know about engineering admissions in {hub.shortName}.
        </p>
      </div>

      <div class="space-y-3">
        {hub.faqs.map((faq) => (
          <details class="group bg-slate-50 border border-slate-200 rounded-xl p-4 [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex items-center justify-between cursor-pointer font-bold text-slate-900 text-sm sm:text-base">
              <span>{faq.q}</span>
              <span class="ml-4 transition-transform group-open:rotate-180">
                <svg class="w-5 h-5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </span>
            </summary>
            <p class="mt-3 text-slate-600 text-xs sm:text-sm leading-relaxed border-t border-slate-200 pt-3">
              {faq.a}
            </p>
          </details>
        ))}
      </div>

    </div>
  </section>

  <!-- Bottom Direct Consultation Desk -->
  <section class="py-12 bg-gradient-to-r from-slate-900 via-blue-950 to-slate-900 text-white text-center">
    <div class="max-w-3xl mx-auto px-4 space-y-4">
      <h3 class="text-xl sm:text-2xl font-bold">
        Need Admission Assistance for {hub.name}?
      </h3>
      <p class="text-xs sm:text-sm text-slate-300 max-w-xl mx-auto">
        Speak directly with our senior admission advisor specializing in {hub.shortName} colleges. 100% free guidance.
      </p>
      <div class="flex justify-center gap-3 pt-2">
        <a 
          href={`https://wa.me/919000000000?text=Hi%20Konfido%2C%20I%20am%20interested%20in%20engineering%20admissions%20in%20${encodeURIComponent(hub.shortName)}`}
          target="_blank" 
          rel="noopener"
          class="btn-whatsapp text-xs py-2.5 px-5 font-bold"
        >
          WhatsApp {hub.shortName} Counsellor
        </a>
        <a href="/#enquiry" class="btn-gold text-xs py-2.5 px-5 font-bold">
          Book Free Counselling Session
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
