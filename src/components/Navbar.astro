---
const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/colleges', label: 'All 51 Colleges', badge: '51' },
  { href: '/colleges/telangana', label: 'Telangana & Hyd' },
  { href: '/colleges/andhra-pradesh', label: 'Andhra Pradesh' },
  { href: '/colleges/karnataka', label: 'Karnataka (Blr)' },
  { href: '/colleges/tamil-nadu', label: 'Tamil Nadu' },
];
---

<!-- Top Advisory Strip -->
<div class="bg-slate-900 text-slate-300 text-xs py-2 px-4 border-b border-slate-800">
  <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-2">
    <div class="flex items-center gap-2 font-medium">
      <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold bg-amber-500 text-slate-950">
        ADMISSIONS 2025–26
      </span>
      <span>Direct Admission & Management Quota Open for Top Engineering Universities</span>
    </div>
    <div class="flex items-center gap-4 text-slate-300">
      <a href="tel:+919000000000" class="hover:text-amber-400 transition-colors flex items-center gap-1.5 font-medium">
        <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
        </svg>
        Helpline: +91 90000 00000
      </a>
      <span class="text-slate-700 hidden sm:inline">|</span>
      <span class="hidden sm:inline text-emerald-400 font-medium">✓ 100% Free Guidance for Students</span>
    </div>
  </div>
</div>

<!-- Main Header -->
<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200 transition-all shadow-xs" id="navbar">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20 gap-4">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group text-decoration-none">
        <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-blue-700 to-indigo-900 flex items-center justify-center text-white shadow-md shadow-blue-900/20 group-hover:scale-105 transition-transform">
          <!-- Academic Crest Icon -->
          <svg class="w-6 h-6 text-amber-400" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 3L1 9L12 15L21 10.09V17H23V9M5 13.18V17.18L12 21L19 17.18V13.18L12 17L5 13.18Z"/>
          </svg>
        </div>
        <div>
          <div class="flex items-center gap-1.5">
            <span class="text-2xl font-extrabold tracking-tight text-slate-900 font-serif">KONFIDO</span>
            <span class="text-[10px] uppercase font-bold tracking-wider px-1.5 py-0.5 rounded bg-blue-100 text-blue-800">
              EDU
            </span>
          </div>
          <span class="text-[11px] block font-medium text-slate-500 tracking-normal -mt-0.5">
            Higher Education & Admission Advisory
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden lg:flex items-center gap-1 xl:gap-2">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={`px-3.5 py-2 text-sm font-semibold rounded-lg transition-all flex items-center gap-1.5 ${
              currentPath === item.href 
                ? 'text-blue-700 bg-blue-50 font-bold' 
                : 'text-slate-600 hover:text-slate-950 hover:bg-slate-100'
            }`}
          >
            {item.label}
            {item.badge && (
              <span class="text-[10px] font-bold px-1.5 py-0.5 rounded-full bg-amber-100 text-amber-800 border border-amber-200">
                {item.badge}
              </span>
            )}
          </a>
        ))}
      </nav>

      <!-- Right CTAs -->
      <div class="hidden sm:flex items-center gap-3">
        <!-- WhatsApp Quick Chat -->
        <a 
          href="https://wa.me/919000000000?text=Hi%20Konfido%2C%20I%20need%20admission%20guidance%20for%20B.Tech%20colleges" 
          target="_blank" 
          rel="noopener" 
          class="btn-whatsapp text-xs py-2.5 px-3.5"
          aria-label="Direct WhatsApp consultation"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
          </svg>
          <span class="hidden md:inline">WhatsApp</span>
        </a>

        <!-- Main Booking CTA -->
        <a href="#enquiry" class="btn-gold text-xs py-2.5 px-4 shadow-sm">
          <span>Get Free Counselling</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <button
        type="button"
        id="mobile-nav-toggle"
        class="lg:hidden p-2 rounded-lg text-slate-700 hover:text-slate-900 hover:bg-slate-100 focus:outline-none"
        aria-label="Toggle Navigation Menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"/>
        </svg>
      </button>

    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-200 bg-white px-4 pt-3 pb-6 shadow-xl">
    <div class="flex flex-col gap-2">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="px-3 py-2.5 rounded-lg text-sm font-semibold text-slate-800 hover:bg-slate-100 flex items-center justify-between"
        >
          <span>{item.label}</span>
          {item.badge && (
            <span class="text-xs px-2 py-0.5 rounded-full bg-amber-100 text-amber-800 font-bold">
              {item.badge}
            </span>
          )}
        </a>
      ))}
      <div class="pt-3 border-t border-slate-200 flex flex-col gap-2.5 mt-2">
        <a 
          href="https://wa.me/919000000000" 
          target="_blank" 
          class="btn-whatsapp text-sm py-2.5 justify-center w-full"
        >
          Chat on WhatsApp with Counsellor
        </a>
        <a 
          href="#enquiry" 
          class="btn-gold text-sm py-2.5 justify-center w-full"
        >
          Book Free Counselling Session
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-nav-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  toggleBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
    });
  });
</script>
