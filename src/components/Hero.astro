---
// CollegeDunia style High-Conversion Hero with Integrated Search & Lead Capture
---

<section class="relative bg-gradient-to-b from-blue-50/60 via-white to-slate-50 py-12 lg:py-16 border-b border-slate-200 overflow-hidden">
  
  <!-- Subtle decorative background patterns -->
  <div class="absolute inset-0 bg-[radial-gradient(#cbd5e1_1px,transparent_1px)] [background-size:24px_24px] opacity-40 pointer-events-none"></div>
  <div class="absolute top-0 right-1/4 w-96 h-96 bg-blue-100/50 rounded-full blur-3xl pointer-events-none -z-0"></div>
  <div class="absolute bottom-0 left-10 w-80 h-80 bg-amber-100/40 rounded-full blur-3xl pointer-events-none -z-0"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Left Column: Value Proposition & Instant Search Engine (7 cols) -->
      <div class="lg:col-span-7 space-y-6">
        
        <!-- Trust Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-blue-100/80 border border-blue-200/80 text-blue-900 text-xs font-semibold tracking-wide">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>🎓 Admissions 2025–26 Guidance Open for 51 Partner Universities</span>
        </div>

        <!-- Main H1 Heading -->
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight leading-[1.15]">
          Find & Secure Your <br class="hidden sm:inline" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-700 via-indigo-700 to-blue-900">
            B.Tech Admission
          </span> 
          in Top Universities
        </h1>

        <!-- Subheading -->
        <p class="text-base sm:text-lg text-slate-600 leading-relaxed max-w-2xl font-normal">
          Compare verified fee structures, real cutoff ranks, and placement stats across 
          <strong class="text-slate-800 font-semibold">Telangana, Andhra Pradesh, Karnataka, Tamil Nadu</strong>, and North India. 
          Expert 1-on-1 direct admission & management quota assistance.
        </p>

        <!-- CollegeDunia-style Search & Filter Bar -->
        <div class="bg-white p-2.5 sm:p-3 rounded-2xl shadow-lg shadow-slate-200/60 border border-slate-200 max-w-2xl">
          <div class="flex flex-col sm:flex-row gap-2">
            
            <!-- Search Input -->
            <div class="relative flex-1">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
                <svg class="h-5 w-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
              </div>
              <input
                type="text"
                id="hero-college-search"
                placeholder="Search 51 universities (e.g., VIT, Ramaiah, KL, CBIT...)"
                class="w-full pl-10 pr-4 py-3 bg-slate-50 hover:bg-white focus:bg-white rounded-xl text-sm font-medium text-slate-900 placeholder-slate-400 border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all"
              />
            </div>

            <!-- State Quick Selector -->
            <select
              id="hero-state-select"
              class="px-3.5 py-3 bg-slate-50 hover:bg-white focus:bg-white rounded-xl text-sm font-medium text-slate-700 border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all sm:w-44"
              aria-label="Filter universities by state"
            >
              <option value="all">All Locations (51)</option>
              <option value="Telangana">Telangana</option>
              <option value="Andhra Pradesh">Andhra Pradesh</option>
              <option value="Karnataka">Karnataka</option>
              <option value="Tamil Nadu">Tamil Nadu</option>
              <option value="North/West">North & West India</option>
            </select>

            <!-- Search Action Button -->
            <button
              id="hero-search-btn"
              type="button"
              class="btn-gold py-3 px-6 text-sm font-bold shadow-md hover:shadow-lg transition-all"
            >
              Explore
            </button>
          </div>

          <!-- Quick Trending Tags -->
          <div class="mt-3 pt-2.5 border-t border-slate-100 flex items-center gap-2 flex-wrap text-xs text-slate-500">
            <span class="font-bold text-slate-700 flex items-center gap-1">
              <svg class="w-3.5 h-3.5 text-amber-500" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M12.395 2.553a1 1 0 00-1.45-.385c-.345.23-.614.558-.822.88-.214.33-.403.713-.57 1.116-.334.804-.614 1.768-.84 2.734a31.365 31.365 0 00-.613 3.58 2.64 2.64 0 01-.945-1.067c-.328-.68-.398-1.534-.398-2.654A1 1 0 005.05 6.05 6.981 6.981 0 003 11a7 7 0 1011.95-4.95c-.592-.591-.98-.985-1.348-1.467-.363-.476-.724-1.063-1.207-2.03zM12.12 15.12A3 3 0 017 13s.879.5 2.5.5c0-1 .5-4 1.25-4.5.5 1 .786 1.293 1.371 1.879A2.98 2.98 0 0113 13a2.99 2.99 0 01-.879 2.12z" clip-rule="evenodd"/>
              </svg>
              Trending:
            </span>
            <button type="button" class="quick-filter-tag hover:text-blue-700 hover:underline" data-term="VIT">VIT Vellore</button>
            <span>•</span>
            <button type="button" class="quick-filter-tag hover:text-blue-700 hover:underline" data-term="Ramaiah">MS Ramaiah</button>
            <span>•</span>
            <button type="button" class="quick-filter-tag hover:text-blue-700 hover:underline" data-term="PES">PES Bengaluru</button>
            <span>•</span>
            <button type="button" class="quick-filter-tag hover:text-blue-700 hover:underline" data-term="KL">KL University</button>
            <span>•</span>
            <button type="button" class="quick-filter-tag hover:text-blue-700 hover:underline" data-term="Bennett">Bennett Univ</button>
            <span>•</span>
            <button type="button" class="quick-filter-tag hover:text-blue-700 hover:underline" data-term="Chandigarh">Chandigarh Univ</button>
          </div>
        </div>

        <!-- Trust Badges Under Search -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2 text-xs font-semibold text-slate-700">
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-600 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span>100% Free Guidance</span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-600 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span>Direct Quota Guidance</span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-600 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span>Verified Fee Matrix</span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-600 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span>Personal Counsellor</span>
          </div>
        </div>

      </div>

      <!-- Right Column: High-Converting Admission Lead Box (5 cols) -->
      <div class="lg:col-span-5" id="enquiry">
        <div class="bg-white rounded-2xl shadow-xl shadow-slate-300/60 border border-slate-200 overflow-hidden relative">
          
          <!-- Box Header -->
          <div class="bg-gradient-to-r from-slate-900 via-blue-950 to-slate-900 p-5 text-white">
            <div class="flex items-center justify-between">
              <span class="text-xs uppercase font-bold tracking-wider px-2 py-0.5 rounded bg-amber-500 text-slate-950">
                ADMISSION DESK 2025
              </span>
              <span class="text-xs text-slate-300 flex items-center gap-1">
                <span class="w-2 h-2 rounded-full bg-emerald-400"></span> 4 Counsellors Online
              </span>
            </div>
            <h3 class="text-lg font-bold mt-2">Get Free College Shortlist & Fee Sheet</h3>
            <p class="text-xs text-slate-300 mt-0.5">
              Enter your preferences to receive cutoff ranks & seat availability on WhatsApp.
            </p>
          </div>

          <!-- Form Body -->
          <form class="p-6 space-y-4" onsubmit="event.preventDefault(); alert('Thank you! A Konfido Senior Counsellor will contact you on WhatsApp within 15 minutes.');">
            <div>
              <label for="student-name" class="block text-xs font-bold text-slate-700 mb-1">Student Full Name *</label>
              <input 
                id="student-name" 
                type="text" 
                required 
                placeholder="e.g. Rahul Sharma"
                class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all"
              />
            </div>

            <div>
              <label for="student-phone" class="block text-xs font-bold text-slate-700 mb-1">WhatsApp Mobile Number *</label>
              <div class="flex">
                <span class="inline-flex items-center px-3 rounded-l-lg border border-r-0 border-slate-300 bg-slate-100 text-slate-600 text-sm font-semibold">
                  +91
                </span>
                <input 
                  id="student-phone" 
                  type="tel" 
                  pattern="[0-9]{10}" 
                  required 
                  placeholder="98765 43210"
                  class="w-full px-3.5 py-2.5 rounded-r-lg border border-slate-300 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all"
                />
              </div>
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div>
                <label for="pref-state" class="block text-xs font-bold text-slate-700 mb-1">Target State</label>
                <select 
                  id="pref-state"
                  class="w-full px-3 py-2.5 rounded-lg border border-slate-300 text-xs font-medium text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent"
                >
                  <option>Telangana (Hyderabad)</option>
                  <option>Karnataka (Bengaluru)</option>
                  <option>Tamil Nadu (Chennai)</option>
                  <option>Andhra Pradesh</option>
                  <option>North / Other States</option>
                </select>
              </div>

              <div>
                <label for="pref-branch" class="block text-xs font-bold text-slate-700 mb-1">Target Branch</label>
                <select 
                  id="pref-branch"
                  class="w-full px-3 py-2.5 rounded-lg border border-slate-300 text-xs font-medium text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent"
                >
                  <option>B.Tech CSE Core</option>
                  <option>AI & Machine Learning</option>
                  <option>Data Science</option>
                  <option>Cyber Security</option>
                  <option>ECE / Electronics</option>
                  <option>Others / Any Good Branch</option>
                </select>
              </div>
            </div>

            <!-- Submit Button -->
            <button 
              type="submit" 
              class="w-full btn-gold py-3 text-sm font-bold shadow-md hover:shadow-lg transition-all"
            >
              <span>Get Fee Structure & Call Back</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </button>

            <p class="text-[11px] text-center text-slate-500">
              🔒 100% Privacy Guaranteed. Free assistance with direct university quota.
            </p>
          </form>

        </div>
      </div>

    </div>
  </div>
</section>

<script>
  // Handle search and trending tags to scroll down and filter colleges
  const searchInput = document.getElementById('hero-college-search') as HTMLInputElement | null;
  const stateSelect = document.getElementById('hero-state-select') as HTMLSelectElement | null;
  const searchBtn = document.getElementById('hero-search-btn');

  function triggerSearch(term: string) {
    const target = document.getElementById('south-india');
    if (target) {
      target.scrollIntoView({ behavior: 'smooth' });
    }
    const filterInput = document.getElementById('main-college-search') as HTMLInputElement | null;
    if (filterInput) {
      filterInput.value = term;
      filterInput.dispatchEvent(new Event('input'));
    }
  }

  searchBtn?.addEventListener('click', () => {
    if (searchInput) {
      triggerSearch(searchInput.value.trim());
    }
  });

  searchInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      triggerSearch(searchInput.value.trim());
    }
  });

  document.querySelectorAll('.quick-filter-tag').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const term = (e.currentTarget as HTMLElement).getAttribute('data-term') || '';
      if (searchInput) searchInput.value = term;
      triggerSearch(term);
    });
  });
</script>
