{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["global_fetch_strictly_public"],

  "name": "konfido",

  "assets": {
    "directory": "./dist"
  },

  "observability": {
    "enabled": true
  },

  "build": {
    "command": "npm run build"
  }
}